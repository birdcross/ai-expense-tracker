# demo: local JSON storage + explicit demo chat, no image recognition
# production: real OpenAI-compatible calls; storage is selected separately
APP_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=sseumlog
# Alternative to JSON: GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
ALLOWED_ORIGINS=http://localhost:8017,http://127.0.0.1:8017
# Set for a public deployment. Requests use X-App-Token (personal app access).
APP_ACCESS_TOKEN=

# local or firestore; independent of AI mode
STORAGE_MODE=local
# OpenAI-compatible service base URL, including /v1
OPENAI_BASE_URL=

# Image analysis may use a separate Anthropic-compatible key.
VISION_PROVIDER=openai
VISION_MODEL=
ANTHROPIC_BASE_URL=https://copa.codyssey.kr
ANTHROPIC_API_KEY=
